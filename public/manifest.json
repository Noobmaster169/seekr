{
  "manifest_version": 3,
  "name": "Seekr - Instagram Reel Product Detector",
  "version": "1.0.0",
  "description": "Detect fashion products from Instagram Reels using Claude AI. Pure detection - no searching.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://www.instagram.com/*",
    "https://api.openai.com/*",
    "https://*.uniqlo.com/*",
    "http://*.uniqlo.com/*",
    "https://image.uniqlo.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/overlay.js", "assets/style.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
